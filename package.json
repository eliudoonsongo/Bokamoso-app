    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.159.0",
    "zod": "^4.5.4"
